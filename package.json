{
  "name": "x402-crypto-research-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "tsc -p tsconfig.build.json && node dist/server.js",
    "client": "tsc -p tsconfig.build.json && node dist/client.js",
    "test": "node --test src/topic.test.ts src/payment-flow.test.ts src/cost.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@x402/core": "2.25.0",
    "@x402/evm": "2.25.0",
    "@x402/express": "2.25.0",
    "@x402/fetch": "2.25.0",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "openai": "^7.15.0",
    "viem": "^2.37.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
